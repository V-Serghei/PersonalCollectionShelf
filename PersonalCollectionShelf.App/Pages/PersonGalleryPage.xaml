<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.PersonGalleryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:PersonGalleryViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label
                FontAttributes="Bold"
                FontFamily="Cambria"
                FontSize="26"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding PageTitle}" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                Text="{Binding PhotoPositionText}"
                TextColor="{DynamicResource MutedForeground}"
                VerticalTextAlignment="Center" />
        </Grid>

        <Border
            Grid.Row="1"
            BackgroundColor="Black"
            Stroke="{DynamicResource Border}"
            StrokeShape="RoundRectangle 12">
            <Grid>
                <CarouselView
                    x:Name="PhotoCarousel"
                    IsBounceEnabled="True"
                    IsVisible="{Binding HasPhotos}"
                    ItemsSource="{Binding Photos}"
                    Loop="False"
                    Position="{Binding SelectedPhotoIndex, Mode=TwoWay}"
                    VerticalOptions="Fill">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PersonPhotoViewModel">
                            <Grid BackgroundColor="Black">
                                <Image Aspect="AspectFit" Source="{Binding FilePath}" />
                                <Border
                                    Margin="14"
                                    Padding="9,4"
                                    BackgroundColor="#CC201C2D"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding IsPrimary}"
                                    Stroke="{DynamicResource Primary}"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Start">
                                    <Label FontAttributes="Bold" FontSize="11" Text="{Binding PrimaryText}" TextColor="{DynamicResource Primary}" />
                                </Border>
                                <Border
                                    Margin="14"
                                    Padding="12,8"
                                    BackgroundColor="#CC100E1A"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding HasCaption}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="End">
                                    <Label HorizontalTextAlignment="Center" MaxLines="3" Text="{Binding Caption}" TextColor="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <Label
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding HasNoPhotos}"
                    Text="{Binding EmptyText}"
                    TextColor="White"
                    VerticalTextAlignment="Center" />

                <Button
                    Command="{Binding ShowPreviousPhotoCommand}"
                    HeightRequest="48"
                    HorizontalOptions="Start"
                    IsVisible="{Binding CanShowPreviousPhoto}"
                    Margin="10"
                    Padding="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="&#x2039;"
                    ToolTipProperties.Text="{Binding PreviousPhotoText}"
                    VerticalOptions="Center"
                    WidthRequest="48" />
                <Button
                    Command="{Binding ShowNextPhotoCommand}"
                    HeightRequest="48"
                    HorizontalOptions="End"
                    IsVisible="{Binding CanShowNextPhoto}"
                    Margin="10"
                    Padding="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Text="&#x203A;"
                    ToolTipProperties.Text="{Binding NextPhotoText}"
                    VerticalOptions="Center"
                    WidthRequest="48" />
            </Grid>
        </Border>

        <CollectionView
            x:Name="ThumbnailList"
            Grid.Row="2"
            HeightRequest="112"
            ItemsSource="{Binding Photos}"
            SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
            SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:PersonPhotoViewModel">
                    <Border
                        HeightRequest="104"
                        Stroke="{DynamicResource Border}"
                        StrokeShape="RoundRectangle 9"
                        StrokeThickness="1"
                        WidthRequest="78">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Setter Property="Scale" Value="0.96" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Image Aspect="AspectFill" Source="{Binding FilePath}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="3" BackgroundColor="#66000000" IsVisible="{Binding IsBusy}" ZIndex="100">
            <ActivityIndicator Color="{DynamicResource Primary}" IsRunning="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>
