<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.MediaDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:MediaDetailsViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid BackgroundColor="{DynamicResource Background}">
        <Image
            Aspect="AspectFill"
            InputTransparent="True"
            Opacity="{DynamicResource CustomBackgroundImageOpacity}"
            Source="{DynamicResource CustomBackgroundImageSource}" />
        <BoxView
            BackgroundColor="{DynamicResource Background}"
            InputTransparent="True"
            Opacity="{DynamicResource CustomBackgroundOverlayOpacity}" />
        <ScrollView>
        <VerticalStackLayout
            Padding="{OnIdiom Phone=14, Tablet=20, Desktop=24}"
            Spacing="18"
            HorizontalOptions="Center"
            MaximumWidthRequest="980">
            <Border
                Padding="12"
                BackgroundColor="#1AF87171"
                IsVisible="{Binding HasErrorMessage}"
                Stroke="#40F87171"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
            </Border>

            <Grid ColumnDefinitions="190,*" ColumnSpacing="24">
                <Border
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Muted}"
                    HeightRequest="278"
                    Stroke="{StaticResource Border}"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1"
                    WidthRequest="186">
                    <Grid>
                        <Image
                            Aspect="AspectFill"
                            IsVisible="{Binding HasCoverUrl}"
                            Source="{Binding CoverUrl}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="58"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasNoCoverUrl}"
                            Text="{Binding Initial}"
                            TextColor="{StaticResource MutedForeground}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout
                            Margin="10"
                            HorizontalOptions="End"
                            Spacing="7"
                            VerticalOptions="Start">
                            <Button
                                Command="{Binding EditCommand}"
                                Style="{StaticResource PosterIconButtonStyle}"
                                Text="&#xE70F;"
                                ToolTipProperties.Text="{Binding EditButtonText}" />
                            <Button
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource PosterDangerIconButtonStyle}"
                                Text="&#xE74D;"
                                ToolTipProperties.Text="{Binding DeleteButtonText}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PageTitleLabelStyle}" Text="{Binding PageTitle}" />
                        <Label
                            FontSize="14"
                            Text="{Binding OriginalTitleValue}"
                            TextColor="{StaticResource MutedForeground}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="8">
                        <Border
                            Padding="10,5"
                            BackgroundColor="{Binding MediaTypeColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="{Binding TypeValue}"
                                TextColor="White" />
                        </Border>
                        <Border
                            Padding="10,5"
                            BackgroundColor="{Binding StatusBackgroundColor}"
                            Stroke="{Binding StatusForegroundColor}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="{Binding StatusValue}"
                                TextColor="{Binding StatusForegroundColor}" />
                        </Border>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Border Padding="13" Style="{StaticResource CardBorderStyle}" WidthRequest="118">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding RatingLabel}" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        Text="{Binding RatingShort}"
                                        TextColor="{StaticResource Warning}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="22"
                                        Text="--"
                                        TextColor="{StaticResource MutedForeground}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding HasRating}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Padding="13" Style="{StaticResource CardBorderStyle}" WidthRequest="154">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ProgressLabel}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding ProgressValue}" />
                                <ProgressBar
                                    BackgroundColor="{StaticResource Muted}"
                                    IsVisible="{Binding HasProgressBar}"
                                    Progress="{Binding ProgressPercent}"
                                    ProgressColor="{StaticResource Info}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Padding="13" Style="{StaticResource CardBorderStyle}" WidthRequest="122">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FavoriteLabel}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="22"
                                    Text="{Binding FavoriteValue}"
                                    TextColor="#F07CB8" />
                            </VerticalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <Border Padding="18" Style="{StaticResource CardBorderStyle}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding DetailsSectionTitle}" />
                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TypeLabel}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding TypeValue}" />
                        <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StatusLabel}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusValue}" />
                        <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CategoryLabel}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CategoryValue}" />
                        <Label Grid.Row="3" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TagsLabel}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding TagsValue}" />
                        <Label Grid.Row="4" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CreatorLabel}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding CreatorValue}" />
                        <Label Grid.Row="5" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CastLabel}" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding CastValue}" />
                        <Label Grid.Row="6" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding PublisherLabel}" />
                        <Label Grid.Row="6" Grid.Column="1" Text="{Binding PublisherValue}" />
                        <Label Grid.Row="7" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding SerialNumberLabel}" />
                        <Label Grid.Row="7" Grid.Column="1" Text="{Binding SerialNumberValue}" />
                        <Label Grid.Row="8" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding DescriptionLabel}" />
                        <Label Grid.Row="8" Grid.Column="1" Text="{Binding DescriptionValue}" />
                        <Label Grid.Row="9" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding NotesLabel}" />
                        <Label Grid.Row="9" Grid.Column="1" Text="{Binding NotesValue}" />
                        <Label Grid.Row="10" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StartDateLabel}" />
                        <Label Grid.Row="10" Grid.Column="1" Text="{Binding StartDateValue}" />
                        <Label Grid.Row="11" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FinishDateLabel}" />
                        <Label Grid.Row="11" Grid.Column="1" Text="{Binding FinishDateValue}" />
                        <Label Grid.Row="12" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ReleaseYearLabel}" />
                        <Label Grid.Row="12" Grid.Column="1" Text="{Binding ReleaseYearValue}" />
                        <Label Grid.Row="13" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalTitleLabel}" />
                        <Label Grid.Row="13" Grid.Column="1" Text="{Binding OriginalTitleValue}" />
                        <Label Grid.Row="14" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CreatedAtLabel}" />
                        <Label Grid.Row="14" Grid.Column="1" Text="{Binding CreatedAtValue}" />
                        <Label Grid.Row="15" Grid.Column="0" Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding UpdatedAtLabel}" />
                        <Label Grid.Row="15" Grid.Column="1" Text="{Binding UpdatedAtValue}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
