<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    Title="{Binding PageTitle}">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <SearchBar
            Grid.Row="0"
            Placeholder="{Binding SearchPlaceholder}"
            SearchCommand="{Binding LoadCommand}"
            Text="{Binding SearchTerm}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Picker
                Grid.Column="0"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding MediaTypeFilters}"
                SelectedItem="{Binding SelectedMediaTypeFilter}"
                Title="{Binding MediaTypeFilterPlaceholder}" />
            <Picker
                Grid.Column="1"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding StatusFilters}"
                SelectedItem="{Binding SelectedStatusFilter}"
                Title="{Binding StatusFilterPlaceholder}" />
            <Button
                Grid.Column="2"
                Command="{Binding CreateMediaItemCommand}"
                Text="{Binding AddButtonText}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Picker
                Grid.Column="0"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding CategoryFilters}"
                SelectedItem="{Binding SelectedCategoryFilter}"
                Title="{Binding CategoryFilterPlaceholder}" />
            <Picker
                Grid.Column="1"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding TagFilters}"
                SelectedItem="{Binding SelectedTagFilter}"
                Title="{Binding TagFilterPlaceholder}" />
        </Grid>

        <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Command="{Binding ShowAllCommand}" Text="{Binding QuickFilterAllText}" />
                <Button Command="{Binding ShowFavoritesCommand}" Text="{Binding QuickFilterFavoritesText}" />
                <Button Command="{Binding ShowMissingCategoryCommand}" Text="{Binding QuickFilterMissingCategoryText}" />
                <Button Command="{Binding ShowMissingCoverCommand}" Text="{Binding QuickFilterMissingCoverText}" />
                <Button Command="{Binding ShowCompletedCommand}" Text="{Binding QuickFilterCompletedText}" />
                <Button Command="{Binding ShowInProgressCommand}" Text="{Binding QuickFilterInProgressText}" />
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView
            Grid.Row="4"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">
            <CollectionView
                ItemsSource="{Binding MediaItems}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EmptyLibraryText}"
                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#D1D5DB}" />
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                        <Border
                            Margin="0,0,0,10"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                            Stroke="{AppThemeBinding Light=#D9DEE8, Dark=#374151}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMediaItemCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="76,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                <Border
                                    Grid.RowSpan="4"
                                    Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#111827}"
                                    HeightRequest="104"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    WidthRequest="72">
                                    <Grid>
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="104"
                                            IsVisible="{Binding HasCoverUrl}"
                                            Source="{Binding CoverUrl}"
                                            WidthRequest="72" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="28"
                                            HorizontalOptions="Center"
                                            IsVisible="{Binding HasNoCoverUrl}"
                                            Text="{Binding Initial}"
                                            TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding FavoriteMarker}"
                                    TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Metadata}"
                                    TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding CategoryLine}"
                                    TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    HorizontalOptions="End"
                                    Text="{Binding Rating}" />
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="12">
                                    <Label Text="{Binding Progress}" />
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding TagsLine}" />
                                </HorizontalStackLayout>
                                <Button
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMediaItemCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="False"
                                    Text="{Binding OpenButtonText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
