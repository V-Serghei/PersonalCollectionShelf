<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    Title="{Binding PageTitle}">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <SearchBar
            Grid.Row="0"
            Placeholder="{Binding SearchPlaceholder}"
            SearchCommand="{Binding LoadCommand}"
            Text="{Binding SearchTerm}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <Picker
                Grid.Column="0"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding MediaTypeFilters}"
                SelectedItem="{Binding SelectedMediaTypeFilter}"
                Title="{Binding MediaTypeFilterPlaceholder}" />
            <Picker
                Grid.Column="1"
                ItemDisplayBinding="{Binding DisplayName}"
                ItemsSource="{Binding StatusFilters}"
                SelectedItem="{Binding SelectedStatusFilter}"
                Title="{Binding StatusFilterPlaceholder}" />
            <Button
                Grid.Column="2"
                Command="{Binding CreateMediaItemCommand}"
                Text="{Binding AddButtonText}" />
        </Grid>

        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy}">
            <CollectionView
                ItemsSource="{Binding MediaItems}"
                SelectionMode="None">
                <CollectionView.EmptyView>
                    <Grid Padding="24">
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EmptyLibraryText}"
                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#D1D5DB}" />
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                            Stroke="{AppThemeBinding Light=#D9DEE8, Dark=#374151}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMediaItemCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding Title}" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding FavoriteMarker}"
                                    TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Metadata}"
                                    TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Spacing="12">
                                    <Label Text="{Binding Progress}" />
                                    <Label Text="{Binding Rating}" />
                                </HorizontalStackLayout>
                                <Button
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMediaItemCommand}"
                                    CommandParameter="{Binding .}"
                                    Text="{Binding OpenButtonText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
