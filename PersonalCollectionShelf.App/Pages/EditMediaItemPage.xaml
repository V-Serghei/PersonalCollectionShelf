<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.EditMediaItemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:PersonalCollectionShelf.Application.DTOs;assembly=PersonalCollectionShelf.Application"
    xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:EditMediaItemViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid x:Name="PageLayout" BackgroundColor="{DynamicResource PageBackground}" ColumnDefinitions="*,1040,*" Padding="24">
        <ScrollView x:Name="FormScrollView" Grid.Column="1" BackgroundColor="{DynamicResource PageBackground}" VerticalOptions="Fill">
            <Border
                x:Name="FormCard"
                Padding="30,26"
                BackgroundColor="{DynamicResource Card}"
                Stroke="{DynamicResource Border}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Cambria"
                            FontSize="23"
                            Text="{Binding PageTitle}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            CornerRadius="16"
                            HeightRequest="44"
                            Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="×"
                            WidthRequest="44" />
                    </Grid>

                    <Border
                        Padding="12"
                        BackgroundColor="#1AF87171"
                        IsVisible="{Binding HasErrorMessage}"
                        Stroke="#40F87171"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Label FontSize="12" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                    </Border>

                    <Grid x:Name="MainFormGrid" ColumnDefinitions="*,*" ColumnSpacing="32">
                        <!-- Left column: identity & categorization -->
                        <VerticalStackLayout x:Name="IdentityColumn" Grid.Column="0" Spacing="20">
                            <Grid ColumnDefinitions="104,*" ColumnSpacing="16">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource Muted}"
                                    HeightRequest="144"
                                    Stroke="{DynamicResource Border}"
                                    StrokeDashArray="4,3"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    WidthRequest="104">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickCoverCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <VerticalStackLayout HorizontalOptions="Center" IsVisible="{Binding HasNoCoverUrl}" Spacing="4" VerticalOptions="Center">
                                            <Label FontSize="24" HorizontalTextAlignment="Center" Text="＋" TextColor="{DynamicResource MutedForeground}" />
                                            <Label FontSize="10" HorizontalTextAlignment="Center" Text="{Binding AddCoverText}" TextColor="{DynamicResource MutedForeground}" />
                                        </VerticalStackLayout>
                                        <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TitleLabel}" />
                                        <Entry Placeholder="{Binding TitlePlaceholder}" Text="{Binding ItemTitle}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalTitleLabel}" />
                                        <Entry Placeholder="{Binding OriginalTitlePlaceholder}" Text="{Binding OriginalTitle}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CategoryLabel}" />
                                <Entry Placeholder="{Binding CategoryPlaceholder}" Text="{Binding Category}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CoverUrlLabel}" />
                                <Entry Placeholder="{Binding CoverUrlPlaceholder}" Text="{Binding CoverUrl}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MediaTypeLabel}" />
                                    <Picker
                                        ItemsSource="{Binding MediaTypes}"
                                        SelectedItem="{Binding SelectedMediaType}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StatusLabel}" />
                                    <Picker
                                        ItemsSource="{Binding Statuses}"
                                        SelectedItem="{Binding SelectedStatus}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14" IsVisible="{Binding ShowLegacyCreditFields}">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CreatorLabel}" />
                                    <Entry Placeholder="{Binding CreatorPlaceholder}" Text="{Binding Creator}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding PublisherLabel}" />
                                    <Entry Placeholder="{Binding PublisherPlaceholder}" Text="{Binding Publisher}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding ShowCastField}" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CastLabel}" />
                                <FlexLayout
                                    BindableLayout.ItemsSource="{Binding CastChips}"
                                    Direction="Row"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Margin="0,0,8,8"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Muted}"
                                                Stroke="{DynamicResource Border}"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="1">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label FontSize="13" Text="{Binding .}" VerticalTextAlignment="Center" />
                                                    <Button
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveCastCommand, x:DataType={x:Type pages:EditMediaItemPage}}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource IconToggleButtonStyle}"
                                                        Text="×" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Entry
                                    Placeholder="{Binding CastPlaceholder}"
                                    ReturnCommand="{Binding AddCastCommand}"
                                    ReturnType="Done"
                                    Text="{Binding NewCastText}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ReleaseYearLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ReleaseYearPlaceholder}" Text="{Binding ReleaseYear}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding SerialNumberLabel}" />
                                    <Entry Placeholder="{Binding SerialNumberPlaceholder}" Text="{Binding SerialNumber}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Right column: progress, dates, tags, notes -->
                        <VerticalStackLayout x:Name="TrackingColumn" Grid.Column="1" Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding RatingLabel}" />
                                    <Grid ColumnDefinitions="120,Auto" ColumnSpacing="6">
                                        <Entry Keyboard="Numeric" Placeholder="{Binding RatingPlaceholder}" Text="{Binding Rating}" />
                                        <Button Grid.Column="1" Command="{Binding ClearRatingCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="×" />
                                    </Grid>
                                    <FlexLayout BindableLayout.ItemsSource="{Binding RatingStars}" Direction="Row" Wrap="NoWrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:RatingStarViewModel">
                                                <Label Margin="0,0,3,0" FontSize="23" Text="{Binding Glyph}" TextColor="{DynamicResource Accent}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.SetRatingCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding Value}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="End">
                                    <Button
                                        Command="{Binding ToggleFavoriteCommand}"
                                        FontSize="25"
                                        HeightRequest="44"
                                        Padding="8,2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Text="{Binding FavoriteIcon}"
                                        TextColor="{Binding FavoriteIconColor}"
                                        ToolTipProperties.Text="{Binding FavoriteLabel}"
                                        WidthRequest="52" />
                                    <Label FontSize="11" HorizontalTextAlignment="Center" Text="{Binding FavoriteLabel}" TextColor="{DynamicResource MutedForeground}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ProgressCurrentLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ProgressCurrentPlaceholder}" Text="{Binding ProgressCurrent}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ProgressTotalLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ProgressTotalPlaceholder}" Text="{Binding ProgressTotal}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StartDateLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <DatePicker Grid.Column="0" Date="{Binding StartDate}">
                                        <DatePicker.Triggers>
                                            <DataTrigger Binding="{Binding HasStartDate}" TargetType="DatePicker" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource MutedForeground}" />
                                            </DataTrigger>
                                        </DatePicker.Triggers>
                                    </DatePicker>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding ClearStartDateCommand}"
                                        IsVisible="{Binding HasStartDate}"
                                        Style="{StaticResource IconToggleButtonStyle}"
                                        Text="×" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FinishDateLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <DatePicker Grid.Column="0" Date="{Binding FinishDate}">
                                        <DatePicker.Triggers>
                                            <DataTrigger Binding="{Binding HasFinishDate}" TargetType="DatePicker" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource MutedForeground}" />
                                            </DataTrigger>
                                        </DatePicker.Triggers>
                                    </DatePicker>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding ClearFinishDateCommand}"
                                        IsVisible="{Binding HasFinishDate}"
                                        Style="{StaticResource IconToggleButtonStyle}"
                                        Text="×" />
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TagsLabel}" />
                                <FlexLayout
                                    BindableLayout.ItemsSource="{Binding TagChips}"
                                    Direction="Row"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Margin="0,0,8,8"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Muted}"
                                                Stroke="{DynamicResource Border}"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="1">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label FontSize="13" Text="{Binding .}" VerticalTextAlignment="Center" />
                                                    <Button
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveTagCommand, x:DataType={x:Type pages:EditMediaItemPage}}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource IconToggleButtonStyle}"
                                                        Text="×" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Entry
                                    Placeholder="{Binding TagsPlaceholder}"
                                    ReturnCommand="{Binding AddTagCommand}"
                                    ReturnType="Done"
                                    Text="{Binding NewTagText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding DescriptionLabel}" />
                                <Editor AutoSize="TextChanges" HeightRequest="72" Placeholder="{Binding DescriptionPlaceholder}" Text="{Binding Description}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding NotesLabel}" />
                                <Editor AutoSize="TextChanges" HeightRequest="72" Placeholder="{Binding NotesPlaceholder}" Text="{Binding Notes}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding ShowPublicationFields}" Spacing="18">
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label FontAttributes="Bold" FontSize="18" Text="{Binding PublicationDetailsSectionTitle}" />

                        <Grid x:Name="BookDetailsGrid" ColumnDefinitions="*,*" ColumnSpacing="32">
                            <VerticalStackLayout x:Name="BookPeopleColumn" Grid.Column="0" Spacing="16">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding AuthorsLabel}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Authors}" Direction="Row" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ContributorChipViewModel">
                                            <Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14">
                                                <HorizontalStackLayout Spacing="7">
                                                    <Label Text="{Binding Name}" VerticalTextAlignment="Center" />
                                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.MoveContributorUpCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="↑" />
                                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.MoveContributorDownCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="↓" />
                                                    <Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveContributorCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Author" HorizontalOptions="Start" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" />

                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TranslatorsLabel}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Translators}" Direction="Row" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveContributorCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Translator" HorizontalOptions="Start" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding IllustratorsLabel}" /><Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Illustrator" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditorsLabel}" /><Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Editor" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" /></VerticalStackLayout>
                                </Grid>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Illustrators}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveContributorCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Editors}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveContributorCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding GenresLabel}" />
                                    <FlexLayout BindableLayout.ItemsSource="{Binding GenreChips}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding .}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveGenreCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                                    <Entry Placeholder="{Binding GenresPlaceholder}" ReturnCommand="{Binding AddGenreCommand}" ReturnType="Done" Text="{Binding NewGenreText}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="BookMetadataColumn" Grid.Column="1" IsVisible="{Binding ShowBookFields}" Spacing="16">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding SubtitleLabel}" /><Entry Text="{Binding Subtitle}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionLabel}" /><Entry Text="{Binding Edition}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionNumberLabel}" /><Entry Keyboard="Numeric" Text="{Binding EditionNumber}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BookFormatLabel}" /><Picker ItemsSource="{Binding BookFormats}" SelectedItem="{Binding SelectedBookFormat}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalPublicationYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding OriginalPublicationYear}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding EditionYear}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TranslationYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding TranslationYear}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalLanguageLabel}" /><Entry Text="{Binding OriginalLanguage}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BookLanguageLabel}" /><Entry Text="{Binding BookLanguage}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding PageCountLabel}" /><Entry Keyboard="Numeric" Text="{Binding PageCount}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding Isbn10Label}" /><Entry Text="{Binding Isbn10}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding Isbn13Label}" /><Entry Text="{Binding Isbn13}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BindingLabel}" /><Entry Text="{Binding Binding}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CountryOfOriginLabel}" /><Entry Text="{Binding CountryOfOrigin}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding AgeRatingLabel}" /><Entry Text="{Binding AgeRating}" /></VerticalStackLayout></Grid>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid x:Name="BookRelationsGrid" ColumnDefinitions="*,*" ColumnSpacing="32">
                            <VerticalStackLayout x:Name="BookCollectionColumn" Spacing="10">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding CollectionsSectionTitle}" />
                                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10"><Entry Placeholder="{Binding CollectionNamePlaceholder}" Text="{Binding CollectionName}" /><Picker Grid.Column="1" ItemsSource="{Binding CollectionKinds}" SelectedItem="{Binding SelectedCollectionKind}" /><Entry Grid.Column="2" Keyboard="Numeric" Placeholder="{Binding EditionNumberLabel}" Text="{Binding CollectionPosition}" /></Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="BookRelatedItemsColumn" Grid.Column="1" Spacing="10">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding RelationsSectionTitle}" />
                                <Grid ColumnDefinitions="*,150" ColumnSpacing="10"><Entry Placeholder="{Binding RelatedSearchPlaceholder}" Text="{Binding RelatedSearchText}" /><Picker Grid.Column="1" ItemsSource="{Binding RelationKinds}" SelectedItem="{Binding SelectedRelationKind}" /></Grid>
                                <CollectionView HeightRequest="100" ItemsSource="{Binding RelatedSearchResults}"><CollectionView.ItemTemplate><DataTemplate x:DataType="dto:MediaItemDto"><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.AddRelatedItemCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" HorizontalOptions="Fill" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding Title}" /></DataTemplate></CollectionView.ItemTemplate></CollectionView>
                                <FlexLayout BindableLayout.ItemsSource="{Binding RelatedItems}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:RelatedItemChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Title}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveRelatedItemCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShowScreenProductionFields}" Spacing="18">
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label IsVisible="{Binding ShowMovieFields}" FontAttributes="Bold" FontSize="18" Text="{Binding MovieDetailsSectionTitle}" />
                        <Grid x:Name="MovieDetailsGrid" IsVisible="{Binding ShowMovieFields}" ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                            <VerticalStackLayout x:Name="MovieRuntimeField" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MovieRuntimeLabel}" />
                                <Entry Keyboard="Numeric" Text="{Binding MovieRuntimeMinutes}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="MovieCountryField" Grid.Column="1" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MovieCountryLabel}" />
                                <Entry Text="{Binding MovieCountryOfOrigin}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="MovieOriginalLanguageField" Grid.Row="1" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MovieOriginalLanguageLabel}" />
                                <Entry Text="{Binding MovieOriginalLanguage}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="MovieLanguageField" Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MovieLanguageLabel}" />
                                <Entry Text="{Binding MovieLanguage}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="MovieAgeRatingField" Grid.Row="2" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MovieAgeRatingLabel}" />
                                <Entry Text="{Binding MovieAgeRating}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label FontAttributes="Bold" FontSize="18" Text="{Binding MoviePeopleSectionTitle}" />

                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding DirectorsLabel}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Directors}" Direction="Row" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Button Command="{Binding Source={RelativeSource AncestorType={x:Type pages:EditMediaItemPage}}, Path=ViewModel.RemoveContributorCommand, x:DataType={x:Type pages:EditMediaItemPage}}" CommandParameter="{Binding .}" Style="{StaticResource IconToggleButtonStyle}" Text="×" /></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Director" HorizontalOptions="Start" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" />
                            </VerticalStackLayout>

