<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid BackgroundColor="{DynamicResource Background}" RowDefinitions="52,*">
        <Image
            Grid.RowSpan="2"
            Aspect="AspectFill"
            InputTransparent="True"
            Opacity="{DynamicResource CustomBackgroundImageOpacity}"
            Source="{DynamicResource CustomBackgroundImageSource}" />
        <BoxView
            Grid.RowSpan="2"
            BackgroundColor="{DynamicResource Background}"
            InputTransparent="True"
            Opacity="{DynamicResource CustomBackgroundOverlayOpacity}" />
        <Grid
            Grid.Row="0"
            Padding="18,7"
            BackgroundColor="{DynamicResource Background}"
            ColumnDefinitions="310,Auto,*"
            ColumnSpacing="10">
            <Border Grid.Column="0" Padding="12,0" Style="{StaticResource MutedBorderStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE721;" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" BackgroundColor="Transparent" Placeholder="Search..." />
                    <Border Grid.Column="2" Padding="6,2" BackgroundColor="{StaticResource MutedSoft}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 4" StrokeThickness="1" VerticalOptions="Center">
                        <Label FontSize="10" Text="⌘K" TextColor="{StaticResource MutedForeground}" />
                    </Border>
                </Grid>
            </Border>
            <Button Grid.Column="1" Command="{Binding CreateMediaItemCommand}" Text="+  Add Item" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="0,24,0,30"
                HorizontalOptions="Center"
                MaximumWidthRequest="584"
                Spacing="24"
                WidthRequest="584">
                <Label FontAttributes="Bold" FontFamily="Cambria" FontSize="30" Text="{Binding PageTitle}" />

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="APPEARANCE" />
                    <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding ThemeSectionTitle}" />
                                    <Label FontSize="12" Text="{Binding ThemeModeDescription}" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding IsDarkTheme}" OnColor="{StaticResource Primary}" ThumbColor="White" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                            <Grid Padding="16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Background Image" />
                                    <Label FontSize="12" Text="{Binding BackgroundImageDescription}" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding PickBackgroundImageCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Text="Choose" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding ClearBackgroundImageCommand}"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Text="Clear" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                            <Grid Padding="16" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label FontAttributes="Bold" FontSize="14" Text="Background Softness" />
                                        <Label FontSize="12" Text="For your custom background image" TextColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontAttributes="Bold" FontSize="13" Text="{Binding BackgroundBlurText}" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                                </Grid>
                                <Slider
                                    Grid.Row="1"
                                    Maximum="40"
                                    MaximumTrackColor="{StaticResource Border}"
                                    Minimum="0"
                                    MinimumTrackColor="{StaticResource Primary}"
                                    ThumbColor="{StaticResource Primary}"
                                    Value="{Binding BackgroundBlur}" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />

                            <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Accent Color" />
                                    <Label FontSize="12" Text="Personalize your highlight color" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                    <Border BackgroundColor="{StaticResource Primary}" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                    <Border BackgroundColor="{StaticResource Info}" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                    <Border BackgroundColor="{StaticResource Success}" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                    <Border BackgroundColor="{StaticResource Warning}" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                    <Border BackgroundColor="#F07CB8" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                    <Border BackgroundColor="#E07C54" HeightRequest="20" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="20" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Label
                                Padding="16,0,16,16"
                                FontSize="12"
                                Text="{Binding AppearanceStatusMessage}"
                                TextColor="{StaticResource MutedForeground}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="ACCOUNT" />
                    <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border BackgroundColor="#269D7FF4" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="40">
                                <Label FontAttributes="Bold" FontSize="17" HorizontalTextAlignment="Center" Text="A" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="14" Text="Alex Morgan" />
                                <Label FontSize="12" Text="alex@example.com" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" FontAttributes="Bold" FontSize="12" Text="Edit" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="DATA &amp; IMPORT" />
                    <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding ExportButtonText}" />
                                    <Label FontSize="12" Text="Download as CSV or JSON" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Command="{Binding ExportCommand}" Style="{StaticResource LinkButtonStyle}" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding ImportButtonText}" />
                                    <Label FontSize="12" Text="Import collection JSON" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Command="{Binding ImportCommand}" Style="{StaticResource LinkButtonStyle}" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Import from Letterboxd" />
                                    <Label FontSize="12" Text="Movies and TV series ratings" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Import from Goodreads" />
                                    <Label FontSize="12" Text="Books, shelves, and reviews" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Import from Steam" />
                                    <Label FontSize="12" Text="Games, playtime, and achievements" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" />
                            <Grid Padding="16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label FontAttributes="Bold" FontSize="14" Text="Import from MyAnimeList" />
                                    <Label FontSize="12" Text="Anime and manga lists" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding LanguageSectionTitle}" />
                    <Border Padding="16" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnDefinitions="*,190" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label FontAttributes="Bold" FontSize="14" Text="{Binding LanguageSectionTitle}" />
                                <Label FontSize="12" Text="{Binding LanguageDescription}" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Picker Grid.Column="1" ItemDisplayBinding="{Binding DisplayName}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageOption}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
