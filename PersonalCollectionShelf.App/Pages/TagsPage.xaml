<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PersonalCollectionShelf.App.Pages.TagsPage" x:Name="Root" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:dto="clr-namespace:PersonalCollectionShelf.Application.DTOs;assembly=PersonalCollectionShelf.Application" xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages" xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels" x:DataType="viewModels:TagsViewModel" BackgroundColor="{DynamicResource PageBackground}">
    <ScrollView><VerticalStackLayout Padding="18" Spacing="16"><Label FontAttributes="Bold" FontFamily="Cambria" FontSize="28" Text="{Binding PageTitle}" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Tags}" Spacing="14"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:TagGroupViewModel"><Border Padding="16" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label FontAttributes="Bold" FontSize="18" Text="{Binding Name}" /><FlexLayout BindableLayout.ItemsSource="{Binding Items}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="dto:MediaItemDto"><Button Command="{Binding Source={x:Reference Root}, Path=ViewModel.OpenItemCommand, x:DataType={x:Type pages:TagsPage}}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding Title}" /></DataTemplate></BindableLayout.ItemTemplate></FlexLayout></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></ScrollView>
</ContentPage>
