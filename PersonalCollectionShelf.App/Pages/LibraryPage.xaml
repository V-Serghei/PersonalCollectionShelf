<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalCollectionShelf.App.Models"
    xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid BackgroundColor="{DynamicResource PageBackground}" RowDefinitions="52,*">
        <Grid
            x:Name="TopBar"
            Grid.Row="0"
            Padding="18,7"
            BackgroundColor="{DynamicResource PageBackground}"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto"
            ColumnSpacing="6">
            <Border Grid.Column="0" IsVisible="{Binding IsSearchVisible}" Padding="12,0" Style="{StaticResource MutedBorderStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label FontSize="15" Text="⌕" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                    <Entry x:Name="TopSearchEntry" Grid.Column="1" BackgroundColor="Transparent" Placeholder="{Binding SearchPlaceholder}" Text="{Binding SearchTerm}" />
                    <Border Grid.Column="2" IsVisible="{OnIdiom Phone=False, Default=True}" Padding="6,2" BackgroundColor="{DynamicResource MutedSoft}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 4" StrokeThickness="1" VerticalOptions="Center">
                        <Label FontSize="10" Text="Ctrl K" TextColor="{DynamicResource MutedForeground}" />
                    </Border>
                </Grid>
            </Border>
            <Button Grid.Column="1" Command="{Binding ToggleViewCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="{Binding ViewModeIcon}" />
            <Button Grid.Column="2" Clicked="HandleSearchClicked" Style="{StaticResource IconToggleButtonStyle}" Text="⌕" />
            <Button Grid.Column="3" Command="{Binding ToggleFiltersCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="⋮" />
            <Button Grid.Column="4" Command="{Binding CreateMediaItemCommand}" FontSize="24" HeightRequest="40" Padding="0" Text="+" WidthRequest="44" />
        </Grid>

        <Grid
            x:Name="LibraryContent"
            Grid.Row="1"
            Padding="0,8,0,0"
            HorizontalOptions="Fill"
            MaximumWidthRequest="920"
            RowDefinitions="Auto,*"
            RowSpacing="6">
            <VerticalStackLayout x:Name="FilterPanel" Grid.Row="0" IsVisible="{Binding IsFilterPanelVisible}" Spacing="6">
                <Grid x:Name="FilterGrid" ColumnDefinitions="*,44,44" ColumnSpacing="6">
                    <Label FontSize="11" Text="{Binding LibraryCountText}" TextColor="{DynamicResource Primary}" VerticalTextAlignment="Center" />
                    <Grid Grid.Column="1" HeightRequest="40" WidthRequest="44">
                        <Border BackgroundColor="{DynamicResource Muted}" StrokeThickness="0" StrokeShape="RoundRectangle 10" />
                        <Label FontSize="18" HorizontalTextAlignment="Center" Text="◉" VerticalTextAlignment="Center" />
                        <Picker x:Name="StatusPicker" ItemsSource="{Binding StatusFilters}" Opacity="0.01" SelectedItem="{Binding SelectedStatusFilter}" />
                    </Grid>
                    <Grid Grid.Column="2" HeightRequest="40" WidthRequest="44">
                        <Border BackgroundColor="{DynamicResource Muted}" StrokeThickness="0" StrokeShape="RoundRectangle 10" />
                        <Label FontSize="20" HorizontalTextAlignment="Center" Text="↕" VerticalTextAlignment="Center" />
                        <Picker x:Name="SortPicker" ItemsSource="{Binding SortOptions}" Opacity="0.01" SelectedItem="{Binding SelectedSortOption}" />
                    </Grid>
                </Grid>

                <CollectionView
                    x:Name="MediaTypeFilterList"
                    BackgroundColor="{DynamicResource PageBackground}"
                    HeightRequest="44"
                    ItemsSource="{Binding MediaTypeFilters}"
                    SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DisplayOption">
                        <Button
                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.SelectMediaTypeFilterCommand, x:DataType={x:Type pages:LibraryPage}}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource PillButtonStyle}"
                            Text="{Binding DisplayName}">
                            <Button.Triggers><DataTrigger Binding="{Binding IsSelected}" TargetType="Button" Value="True"><Setter Property="BackgroundColor" Value="{DynamicResource Primary}" /><Setter Property="TextColor" Value="{DynamicResource PrimaryForeground}" /></DataTrigger></Button.Triggers>
                        </Button>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Grid Grid.Row="1" BackgroundColor="{DynamicResource PageBackground}">
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    ZIndex="20" />
                <CollectionView
                    x:Name="GridLibraryList"
                    BackgroundColor="{DynamicResource PageBackground}"
                    IsVisible="{Binding IsGridView}"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding MediaItems}"
                    Scrolled="HandleLibraryScrolled"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="14"
                            Orientation="Vertical"
                            SnapPointsAlignment="Start"
                            SnapPointsType="None"
                            Span="{Binding GridColumnCount}"
                            VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Margin="0,50,0,0" Padding="28" HorizontalOptions="Fill" MaximumWidthRequest="340" Style="{StaticResource CardBorderStyle}">
                            <Label HorizontalTextAlignment="Center" Text="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.EmptyLibraryText, x:DataType={x:Type pages:LibraryPage}}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                            <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.OpenMediaItemCommand, x:DataType={x:Type pages:LibraryPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto">
                                    <Grid BackgroundColor="{DynamicResource Muted}" HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.GridPosterHeight, x:DataType={x:Type pages:LibraryPage}}">
                                        <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                        <Label FontAttributes="Bold" FontSize="34" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoCoverUrl}" Text="{Binding Initial}" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                                        <Border Margin="6" Padding="5,2" BackgroundColor="{Binding MediaTypeColor}" HorizontalOptions="Start" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.UseFullGridCard, x:DataType={x:Type pages:LibraryPage}}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Start">
                                            <Label FontAttributes="Bold" FontSize="9" Text="{Binding MediaTypeLabel}" TextColor="White" />
                                        </Border>
                                        <Border Margin="6" Padding="5,2" BackgroundColor="#A0000000" HorizontalOptions="End" IsVisible="{Binding HasReleaseYear}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Start">
                                            <Label FontAttributes="Bold" FontSize="9" Text="{Binding ReleaseYearText}" TextColor="White" />
                                        </Border>
                                        <Border Margin="6" Padding="6,2" BackgroundColor="#A0000000" HorizontalOptions="End" IsVisible="{Binding HasRating}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="End">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontAttributes="Bold" FontSize="10" Text="★" TextColor="{StaticResource Warning}" />
                                                <Label FontAttributes="Bold" FontSize="10" Text="{Binding RatingShort}" TextColor="White" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Padding="7" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                        <Label FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2" MinimumHeightRequest="34" Text="{Binding Title}" />
                                        <Label Grid.Row="1" FontSize="10" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.UseFullGridCard, x:DataType={x:Type pages:LibraryPage}}" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding CategoryLine}" TextColor="{DynamicResource MutedForeground}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                            <Border Padding="7,2" BackgroundColor="{Binding StatusBackgroundColor}" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.UseFullGridCard, x:DataType={x:Type pages:LibraryPage}}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                                <Label FontAttributes="Bold" FontSize="9" Text="{Binding StatusLabel}" TextColor="{Binding StatusForegroundColor}" />
                                            </Border>
                                            <Border Padding="6,2" BackgroundColor="{Binding StatusBackgroundColor}" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.UseCompactGridCard, x:DataType={x:Type pages:LibraryPage}}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                                <Label FontAttributes="Bold" FontSize="11" HorizontalTextAlignment="Center" Text="{Binding StatusIcon}" TextColor="{Binding StatusForegroundColor}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView
                    x:Name="ListLibraryList"
                    BackgroundColor="{DynamicResource PageBackground}"
                    IsVisible="{Binding IsListView}"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemsSource="{Binding MediaItems}"
                    Scrolled="HandleLibraryScrolled"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            ItemSpacing="8"
                            Orientation="Vertical"
                            SnapPointsAlignment="Start"
                            SnapPointsType="None" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Margin="0,50,0,0" Padding="28" HorizontalOptions="Fill" MaximumWidthRequest="340" Style="{StaticResource CardBorderStyle}">
                            <Label HorizontalTextAlignment="Center" Text="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.EmptyLibraryText, x:DataType={x:Type pages:LibraryPage}}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                            <Border HeightRequest="76" Padding="10" Style="{StaticResource CardBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.OpenMediaItemCommand, x:DataType={x:Type pages:LibraryPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="42,*,Auto,Auto,Auto" ColumnSpacing="12">
                                    <Border Padding="0" BackgroundColor="{DynamicResource Muted}" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 6" WidthRequest="42">
                                        <Grid>
                                            <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                            <Label FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoCoverUrl}" Text="{Binding Initial}" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding Title}" />
                                        <Label FontSize="11" LineBreakMode="TailTruncation" Text="{Binding CategoryLine}" TextColor="{DynamicResource MutedForeground}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Padding="8,3" BackgroundColor="{Binding StatusBackgroundColor}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="10" Text="{Binding StatusLabel}" TextColor="{Binding StatusForegroundColor}" />
                                    </Border>
                                    <HorizontalStackLayout Grid.Column="3" IsVisible="{Binding HasRating}" Spacing="4" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="11" Text="★" TextColor="{StaticResource Warning}" />
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding RatingShort}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="4" FontSize="11" Text="{Binding ReleaseYearText}" TextColor="{DynamicResource MutedForeground}" VerticalOptions="Center" WidthRequest="34" HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
