rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.entityType is string
        && request.resource.data.entityKey is string
        && request.resource.data.contentHash is string
        && request.resource.data.changedAt is timestamp
        && request.resource.data.isDeleted is bool;
    }
  }
}
