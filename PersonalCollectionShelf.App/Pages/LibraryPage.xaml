<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalCollectionShelf.App.Models"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid RowDefinitions="52,*">
        <Grid
            Grid.Row="0"
            Padding="18,7"
            BackgroundColor="#CC0D0B14"
            ColumnDefinitions="310,Auto,*"
            ColumnSpacing="10">
            <Border Grid.Column="0" Padding="12,0" Style="{StaticResource MutedBorderStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label FontSize="15" Text="⌕" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" BackgroundColor="Transparent" Placeholder="Search..." Text="{Binding SearchTerm}" />
                    <Border Grid.Column="2" Padding="6,2" BackgroundColor="{StaticResource MutedSoft}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 4" StrokeThickness="1" VerticalOptions="Center">
                        <Label FontSize="10" Text="⌘K" TextColor="{StaticResource MutedForeground}" />
                    </Border>
                </Grid>
            </Border>
            <Button Grid.Column="1" Command="{Binding CreateMediaItemCommand}" Text="+  Add Item" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="0,24,0,0"
            HorizontalOptions="Center"
            MaximumWidthRequest="920"
            RowDefinitions="Auto,Auto,Auto,Auto,*"
            RowSpacing="16"
            WidthRequest="920">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label FontAttributes="Bold" FontFamily="serif" FontSize="30" Text="{Binding PageTitle}" />
                <Border Grid.Column="1" Padding="6" BackgroundColor="{StaticResource Muted}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <HorizontalStackLayout Spacing="6">
                        <Button Style="{StaticResource IconToggleButtonStyle}" Text="▦" />
                        <Button Style="{StaticResource IconToggleButtonStyle}" Text="▪" />
                        <Button Style="{StaticResource IconToggleButtonStyle}" Text="≡" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,130" ColumnSpacing="10">
                <SearchBar
                    Grid.Column="0"
                    Placeholder="Search your library..."
                    SearchCommand="{Binding LoadCommand}"
                    Text="{Binding SearchTerm}" />
                <Picker
                    Grid.Column="1"
                    ItemDisplayBinding="{Binding DisplayName}"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter}"
                    Title="All Status" />
            </Grid>

            <CollectionView
                Grid.Row="2"
                HeightRequest="34"
                ItemsSource="{Binding MediaTypeFilters}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectMediaTypeFilterCommand}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource PillButtonStyle}"
                            Text="{Binding DisplayName}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Grid.Row="3"
                FontSize="12"
                Text="{Binding LibraryCountText}"
                TextColor="{StaticResource Primary}" />

            <RefreshView
                Grid.Row="4"
                Command="{Binding LoadCommand}"
                IsRefreshing="{Binding IsBusy}">
                <CollectionView
                    ItemSizingStrategy="MeasureAllItems"
                    ItemsSource="{Binding MediaItems}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="14"
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=2, Tablet=4, Desktop=5}"
                            VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Margin="0,50,0,0" Padding="28" Style="{StaticResource CardBorderStyle}" WidthRequest="340">
                            <Label HorizontalTextAlignment="Center" Text="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EmptyLibraryText}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                            <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenMediaItemCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="254,Auto">
                                    <Grid BackgroundColor="{StaticResource Muted}">
                                        <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                        <Label FontAttributes="Bold" FontSize="42" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoCoverUrl}" Text="{Binding Initial}" TextColor="{StaticResource MutedForeground}" VerticalTextAlignment="Center" />
                                        <Border Margin="8" Padding="6,3" BackgroundColor="{Binding MediaTypeColor}" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Start">
                                            <Label FontAttributes="Bold" FontSize="9" Text="{Binding MediaTypeLabel}" TextColor="White" />
                                        </Border>
                                        <Border Margin="8" Padding="7,3" BackgroundColor="#A0000000" HorizontalOptions="End" IsVisible="{Binding HasRating}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="End">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontAttributes="Bold" FontSize="10" Text="★" TextColor="{StaticResource Warning}" />
                                                <Label FontAttributes="Bold" FontSize="11" Text="{Binding RatingShort}" TextColor="White" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <ProgressBar BackgroundColor="#33FFFFFF" HeightRequest="3" IsVisible="{Binding HasProgressBar}" Progress="{Binding ProgressPercent}" ProgressColor="{StaticResource Info}" VerticalOptions="End" />
                                    </Grid>

                                    <Grid Grid.Row="1" Padding="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                        <Label FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding Title}" />
                                        <Label Grid.Row="1" FontSize="11" LineBreakMode="TailTruncation" Text="{Binding CategoryLine}" TextColor="{StaticResource MutedForeground}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                            <Border Padding="8,3" BackgroundColor="{Binding StatusBackgroundColor}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                                <Label FontAttributes="Bold" FontSize="10" Text="{Binding StatusLabel}" TextColor="{Binding StatusForegroundColor}" />
                                            </Border>
                                            <Label Grid.Column="1" FontSize="11" HorizontalTextAlignment="End" Text="{Binding ReleaseYearText}" TextColor="{StaticResource MutedForeground}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
