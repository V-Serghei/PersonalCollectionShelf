<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.MediaContributorsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:MediaContributorsViewModel"
    BackgroundColor="{DynamicResource Background}"
    Shell.NavBarIsVisible="False">
    <Grid
        Padding="{OnIdiom Phone='12', Default='24'}"
        BackgroundColor="{DynamicResource Background}"
        RowDefinitions="Auto,*"
        RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Command="{Binding BackCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="&#x2039;" />
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label FontAttributes="Bold" FontFamily="Cambria" FontSize="26" Text="{Binding PageTitle}" />
                <Label FontSize="13" Text="{Binding Title}" TextColor="{DynamicResource Primary}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" BackgroundColor="{DynamicResource Background}">
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Groups}"
                Spacing="18">
                <BindableLayout.EmptyView>
                    <Label Margin="0,40" HorizontalTextAlignment="Center" Text="{Binding EmptyText}" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:MediaContributorGroupViewModel">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding Label}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding People}" Spacing="7">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:MediaContributorItemViewModel">
                                        <Border Padding="13" Style="{StaticResource CardBorderStyle}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pages:MediaContributorsPage}}, Path=ViewModel.OpenPersonCommand, x:DataType={x:Type pages:MediaContributorsPage}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                <Label Grid.Column="1" Text="&#x203A;" TextColor="{DynamicResource Primary}" />
                                                <Label Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" Text="{Binding Details}" TextColor="{DynamicResource MutedForeground}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            ZIndex="10" />
    </Grid>
</ContentPage>
