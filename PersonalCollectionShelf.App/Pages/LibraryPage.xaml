<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PersonalCollectionShelf.App.Models"
    xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid BackgroundColor="{DynamicResource PageBackground}" RowDefinitions="52,*">
        <Grid
            Grid.Row="0"
            Padding="18,7"
            BackgroundColor="{DynamicResource PageBackground}"
            ColumnDefinitions="310,Auto,*"
            ColumnSpacing="10">
            <Border Grid.Column="0" Padding="12,0" Style="{StaticResource MutedBorderStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE721;" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                    <Entry Grid.Column="1" BackgroundColor="Transparent" Placeholder="Search..." Text="{Binding SearchTerm}" />
                    <Border Grid.Column="2" Padding="6,2" BackgroundColor="{DynamicResource MutedSoft}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 4" StrokeThickness="1" VerticalOptions="Center">
                        <Label FontSize="10" Text="⌘K" TextColor="{DynamicResource MutedForeground}" />
                    </Border>
                </Grid>
            </Border>
            <Button Grid.Column="1" Command="{Binding CreateMediaItemCommand}" Text="+  Add Item" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="0,24,0,0"
            HorizontalOptions="Center"
            MaximumWidthRequest="920"
            RowDefinitions="Auto,Auto,Auto,Auto,*"
            RowSpacing="16"
            WidthRequest="920">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label FontAttributes="Bold" FontFamily="Cambria" FontSize="30" Text="{Binding PageTitle}" />
                <Border Grid.Column="1" Padding="6" BackgroundColor="{DynamicResource Muted}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <HorizontalStackLayout Spacing="6">
                        <Button Command="{Binding SetGridViewCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="▦">
                            <Button.Triggers>
                                <DataTrigger Binding="{Binding IsGridView}" TargetType="Button" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                    <Setter Property="BackgroundColor" Value="{DynamicResource MutedSoft}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Command="{Binding SetListViewCommand}" Style="{StaticResource IconToggleButtonStyle}" Text="≡">
                            <Button.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" TargetType="Button" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                    <Setter Property="BackgroundColor" Value="{DynamicResource MutedSoft}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,130,170" ColumnSpacing="10">
                <SearchBar
                    Grid.Column="0"
                    Placeholder="Search your library..."
                    SearchCommand="{Binding LoadCommand}"
                    Text="{Binding SearchTerm}" />
                <Picker
                    Grid.Column="1"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding SelectedStatusFilter}" />
                <Picker
                    Grid.Column="2"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}" />
            </Grid>

            <CollectionView
                BackgroundColor="{DynamicResource PageBackground}"
                Grid.Row="2"
                HeightRequest="44"
                ItemsSource="{Binding MediaTypeFilters}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DisplayOption">
                        <Button
                            Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.SelectMediaTypeFilterCommand, x:DataType={x:Type pages:LibraryPage}}"
                            CommandParameter="{Binding .}"
                            Style="{StaticResource PillButtonStyle}"
                            Text="{Binding DisplayName}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Grid.Row="3"
                FontSize="12"
                Text="{Binding LibraryCountText}"
                TextColor="{DynamicResource Primary}" />

            <RefreshView
                Grid.Row="4"
                BackgroundColor="{DynamicResource PageBackground}"
                Command="{Binding LoadCommand}"
                IsRefreshing="{Binding IsBusy}">
                <Grid>
                <CollectionView
                    BackgroundColor="{DynamicResource PageBackground}"
                    IsVisible="{Binding IsGridView}"
                    ItemSizingStrategy="MeasureAllItems"
                    ItemsSource="{Binding MediaItems}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="14"
                            Orientation="Vertical"
                            Span="{OnIdiom Phone=2, Tablet=5, Desktop=6}"
                            VerticalItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Margin="0,50,0,0" Padding="28" Style="{StaticResource CardBorderStyle}" WidthRequest="340">
                            <Label HorizontalTextAlignment="Center" Text="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.EmptyLibraryText, x:DataType={x:Type pages:LibraryPage}}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                            <Border Padding="0" Style="{StaticResource CardBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.OpenMediaItemCommand, x:DataType={x:Type pages:LibraryPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="206,Auto">
                                    <Grid BackgroundColor="{DynamicResource Muted}">
                                        <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                        <Label FontAttributes="Bold" FontSize="34" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoCoverUrl}" Text="{Binding Initial}" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                                        <Border Margin="8" Padding="6,3" BackgroundColor="{Binding MediaTypeColor}" HorizontalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="Start">
                                            <Label FontAttributes="Bold" FontSize="9" Text="{Binding MediaTypeLabel}" TextColor="White" />
                                        </Border>
                                        <Border Margin="8" Padding="7,3" BackgroundColor="#A0000000" HorizontalOptions="End" IsVisible="{Binding HasRating}" StrokeThickness="0" StrokeShape="RoundRectangle 5" VerticalOptions="End">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontAttributes="Bold" FontSize="10" Text="★" TextColor="{StaticResource Warning}" />
                                                <Label FontAttributes="Bold" FontSize="11" Text="{Binding RatingShort}" TextColor="White" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <ProgressBar BackgroundColor="#33FFFFFF" HeightRequest="3" IsVisible="{Binding HasProgressBar}" Progress="{Binding ProgressPercent}" ProgressColor="{StaticResource Info}" VerticalOptions="End" />
                                    </Grid>

                                    <Grid Grid.Row="1" Padding="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                        <Label FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding Title}" />
                                        <Label Grid.Row="1" FontSize="11" LineBreakMode="TailTruncation" Text="{Binding CategoryLine}" TextColor="{DynamicResource MutedForeground}" />
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                            <Border Padding="8,3" BackgroundColor="{Binding StatusBackgroundColor}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
                                                <Label FontAttributes="Bold" FontSize="10" Text="{Binding StatusLabel}" TextColor="{Binding StatusForegroundColor}" />
                                            </Border>
                                            <Label Grid.Column="1" FontSize="11" HorizontalTextAlignment="End" Text="{Binding ReleaseYearText}" TextColor="{DynamicResource MutedForeground}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <CollectionView
                    BackgroundColor="{DynamicResource PageBackground}"
                    IsVisible="{Binding IsListView}"
                    ItemsSource="{Binding MediaItems}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Border Margin="0,50,0,0" Padding="28" Style="{StaticResource CardBorderStyle}" WidthRequest="340">
                            <Label HorizontalTextAlignment="Center" Text="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.EmptyLibraryText, x:DataType={x:Type pages:LibraryPage}}" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MediaItemListItemViewModel">
                            <Border Padding="10" Style="{StaticResource CardBorderStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pages:LibraryPage}}, Path=ViewModel.OpenMediaItemCommand, x:DataType={x:Type pages:LibraryPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="42,*,Auto,Auto,Auto" ColumnSpacing="12">
                                    <Border Padding="0" BackgroundColor="{DynamicResource Muted}" HeightRequest="56" StrokeThickness="0" StrokeShape="RoundRectangle 6" WidthRequest="42">
                                        <Grid>
                                            <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                            <Label FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" IsVisible="{Binding HasNoCoverUrl}" Text="{Binding Initial}" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding Title}" />
                                        <Label FontSize="11" LineBreakMode="TailTruncation" Text="{Binding CategoryLine}" TextColor="{DynamicResource MutedForeground}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Padding="8,3" BackgroundColor="{Binding StatusBackgroundColor}" Stroke="{Binding StatusForegroundColor}" StrokeShape="RoundRectangle 10" StrokeThickness="1" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="10" Text="{Binding StatusLabel}" TextColor="{Binding StatusForegroundColor}" />
                                    </Border>
                                    <HorizontalStackLayout Grid.Column="3" IsVisible="{Binding HasRating}" Spacing="4" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" FontSize="11" Text="★" TextColor="{StaticResource Warning}" />
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding RatingShort}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="4" FontSize="11" Text="{Binding ReleaseYearText}" TextColor="{DynamicResource MutedForeground}" VerticalOptions="Center" WidthRequest="34" HorizontalTextAlignment="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </Grid>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
