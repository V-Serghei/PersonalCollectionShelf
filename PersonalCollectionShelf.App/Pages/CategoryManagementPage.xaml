<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.CategoryManagementPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:PersonalCollectionShelf.Application.DTOs;assembly=PersonalCollectionShelf.Application"
    xmlns:pages="clr-namespace:PersonalCollectionShelf.App.Pages"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:CategoryManagementViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="64,*" BackgroundColor="{DynamicResource PageBackground}">
        <Grid x:Name="HeaderGrid" Padding="24,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Button x:Name="BackButton" Command="{Binding GoBackCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding BackText}" />
            <Label x:Name="HeaderTitle" Grid.Column="1" FontAttributes="Bold" FontFamily="Cambria" FontSize="28" Text="{Binding PageTitle}" VerticalTextAlignment="Center" />
            <Button x:Name="NewCategoryButton" Grid.Column="2" Command="{Binding NewCategoryCommand}" Text="{Binding NewText}" />
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Padding="24,8,24,24" ColumnDefinitions="280,*" ColumnSpacing="18">
            <Border x:Name="CategoryListCard" Padding="0" Style="{StaticResource CardBorderStyle}">
                <CollectionView ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" SelectionMode="Single">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MediaCategoryDetailsDto">
                            <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontAttributes="Bold" Text="{Binding Name}" />
                                    <Label FontSize="11" Text="{Binding Key}" TextColor="{DynamicResource MutedForeground}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" IsVisible="{Binding IsSystem}" Text="◆" TextColor="{DynamicResource MutedForeground}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <ScrollView x:Name="CategoryEditorScroll" Grid.Column="1">
                <VerticalStackLayout Spacing="16">
                    <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                        <Grid x:Name="CategoryIdentityGrid" ColumnDefinitions="*,260" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                            <VerticalStackLayout x:Name="CategoryNameField">
                                <Label Text="{Binding NameLabel}" />
                                <Entry IsEnabled="{Binding CanEdit}" Text="{Binding Name}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="CategoryBaseTypeField" Grid.Column="1">
                                <Label Text="{Binding BaseTypeLabel}" />
                                <Picker IsEnabled="{Binding CanEdit}" ItemsSource="{Binding BaseTypes}" SelectedItem="{Binding SelectedBaseType}" />
                            </VerticalStackLayout>
                            <Label x:Name="SystemCategoryNotice" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding IsSystemCategory}" Text="{Binding ReadOnlyText}" TextColor="{DynamicResource MutedForeground}" />
                        </Grid>
                    </Border>

                    <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FieldsTitle}" />
                                <Button Grid.Column="1" Command="{Binding AddFieldCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddFieldText}" />
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:CategoryFieldEditor">
                                        <Border Padding="12" Style="{StaticResource MutedBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                <Entry IsEnabled="{Binding Source={x:Reference Root}, Path=ViewModel.CanEdit, x:DataType={x:Type pages:CategoryManagementPage}}" Placeholder="{Binding Source={x:Reference Root}, Path=ViewModel.KeyLabel, x:DataType={x:Type pages:CategoryManagementPage}}" Text="{Binding Key}" />
                                                <Button Grid.Column="1" Command="{Binding Source={x:Reference Root}, Path=ViewModel.RemoveFieldCommand, x:DataType={x:Type pages:CategoryManagementPage}}" CommandParameter="{Binding .}" IsEnabled="{Binding Source={x:Reference Root}, Path=ViewModel.CanEdit, x:DataType={x:Type pages:CategoryManagementPage}}" Style="{StaticResource LinkButtonStyle}" Text="&#x2715;" />
                                                <Entry Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding Source={x:Reference Root}, Path=ViewModel.CanEdit, x:DataType={x:Type pages:CategoryManagementPage}}" Placeholder="{Binding Source={x:Reference Root}, Path=ViewModel.LabelLabel, x:DataType={x:Type pages:CategoryManagementPage}}" Text="{Binding Label}" />
                                                <Picker Grid.Row="2" IsEnabled="{Binding Source={x:Reference Root}, Path=ViewModel.CanEdit, x:DataType={x:Type pages:CategoryManagementPage}}" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Title="{Binding Source={x:Reference Root}, Path=ViewModel.TypeLabel, x:DataType={x:Type pages:CategoryManagementPage}}" />
                                                <Switch Grid.Row="2" Grid.Column="1" IsEnabled="{Binding Source={x:Reference Root}, Path=ViewModel.CanEdit, x:DataType={x:Type pages:CategoryManagementPage}}" IsToggled="{Binding IsRequired}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Button Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" Style="{StaticResource DangerButtonStyle}" Text="{Binding DeleteText}" />
                        <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="{DynamicResource MutedForeground}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Text="{Binding SaveText}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
