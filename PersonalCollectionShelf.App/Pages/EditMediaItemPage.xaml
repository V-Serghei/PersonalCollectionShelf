<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.EditMediaItemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:EditMediaItemViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="{Binding PageTitle}">
    <Grid BackgroundColor="{DynamicResource PageBackground}" ColumnDefinitions="*,1040,*" Padding="24">
        <ScrollView Grid.Column="1" BackgroundColor="{DynamicResource PageBackground}" VerticalOptions="Fill">
            <Border
                Padding="30,26"
                BackgroundColor="{DynamicResource Card}"
                Stroke="{DynamicResource Border}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,32">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="Cambria"
                            FontSize="23"
                            Text="{Binding PageTitle}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding CancelCommand}"
                            CornerRadius="16"
                            FontFamily="Segoe MDL2 Assets"
                            HeightRequest="32"
                            Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="&#xE711;"
                            WidthRequest="32" />
                    </Grid>

                    <Border
                        Padding="12"
                        BackgroundColor="#1AF87171"
                        IsVisible="{Binding HasErrorMessage}"
                        Stroke="#40F87171"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="1">
                        <Label FontSize="12" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
                        <!-- Left column: identity & categorization -->
                        <VerticalStackLayout Grid.Column="0" Spacing="20">
                            <Grid ColumnDefinitions="104,*" ColumnSpacing="16">
                                <Border
                                    Grid.Column="0"
                                    BackgroundColor="{DynamicResource Muted}"
                                    HeightRequest="144"
                                    Stroke="{DynamicResource Border}"
                                    StrokeDashArray="4,3"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    WidthRequest="104">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PickCoverCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid>
                                        <VerticalStackLayout HorizontalOptions="Center" IsVisible="{Binding HasNoCoverUrl}" Spacing="4" VerticalOptions="Center">
                                            <Label FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalTextAlignment="Center" Text="&#xE710;" TextColor="{DynamicResource MutedForeground}" />
                                            <Label FontSize="10" HorizontalTextAlignment="Center" Text="{Binding AddCoverText}" TextColor="{DynamicResource MutedForeground}" />
                                        </VerticalStackLayout>
                                        <Image Aspect="AspectFill" IsVisible="{Binding HasCoverUrl}" Source="{Binding CoverUrl}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TitleLabel}" />
                                        <Entry Placeholder="{Binding TitlePlaceholder}" Text="{Binding ItemTitle}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalTitleLabel}" />
                                        <Entry Placeholder="{Binding OriginalTitlePlaceholder}" Text="{Binding OriginalTitle}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CategoryLabel}" />
                                <Entry Placeholder="{Binding CategoryPlaceholder}" Text="{Binding Category}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CoverUrlLabel}" />
                                <Entry Placeholder="{Binding CoverUrlPlaceholder}" Text="{Binding CoverUrl}" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding MediaTypeLabel}" />
                                    <Picker
                                        ItemDisplayBinding="{Binding DisplayName}"
                                        ItemsSource="{Binding MediaTypes}"
                                        SelectedItem="{Binding SelectedMediaType}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StatusLabel}" />
                                    <Picker
                                        ItemDisplayBinding="{Binding DisplayName}"
                                        ItemsSource="{Binding Statuses}"
                                        SelectedItem="{Binding SelectedStatus}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CreatorLabel}" />
                                    <Entry Placeholder="{Binding CreatorPlaceholder}" Text="{Binding Creator}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding PublisherLabel}" />
                                    <Entry Placeholder="{Binding PublisherPlaceholder}" Text="{Binding Publisher}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding ShowCastField}" Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CastLabel}" />
                                <FlexLayout
                                    BindableLayout.ItemsSource="{Binding CastChips}"
                                    Direction="Row"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Margin="0,0,8,8"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Muted}"
                                                Stroke="{DynamicResource Border}"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="1">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label FontSize="13" Text="{Binding .}" VerticalTextAlignment="Center" />
                                                    <Label
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="10"
                                                        Text="&#xE711;"
                                                        TextColor="{DynamicResource MutedForeground}"
                                                        VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCastCommand}" CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Entry
                                    Placeholder="{Binding CastPlaceholder}"
                                    ReturnCommand="{Binding AddCastCommand}"
                                    ReturnType="Done"
                                    Text="{Binding NewCastText}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ReleaseYearLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ReleaseYearPlaceholder}" Text="{Binding ReleaseYear}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding SerialNumberLabel}" />
                                    <Entry Placeholder="{Binding SerialNumberPlaceholder}" Text="{Binding SerialNumber}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Right column: progress, dates, tags, notes -->
                        <VerticalStackLayout Grid.Column="1" Spacing="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding RatingLabel}" />
                                    <Grid ColumnDefinitions="120,Auto" ColumnSpacing="6">
                                        <Entry Keyboard="Numeric" Placeholder="{Binding RatingPlaceholder}" Text="{Binding Rating}" />
                                        <Button Grid.Column="1" Command="{Binding ClearRatingCommand}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconToggleButtonStyle}" Text="&#xE711;" WidthRequest="36" />
                                    </Grid>
                                    <FlexLayout BindableLayout.ItemsSource="{Binding RatingStars}" Direction="Row" Wrap="NoWrap">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:RatingStarViewModel">
                                                <Label Margin="0,0,3,0" FontSize="23" Text="{Binding Glyph}" TextColor="{DynamicResource Accent}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SetRatingCommand}" CommandParameter="{Binding Value}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center" VerticalOptions="End">
                                    <Label FontSize="28" HorizontalTextAlignment="Center" Text="{Binding FavoriteIcon}" TextColor="{Binding FavoriteIconColor}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label FontSize="11" HorizontalTextAlignment="Center" Text="{Binding FavoriteLabel}" TextColor="{DynamicResource MutedForeground}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ProgressCurrentLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ProgressCurrentPlaceholder}" Text="{Binding ProgressCurrent}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding ProgressTotalLabel}" />
                                    <Entry Keyboard="Numeric" Placeholder="{Binding ProgressTotalPlaceholder}" Text="{Binding ProgressTotal}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding StartDateLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <DatePicker Grid.Column="0" Date="{Binding StartDate}">
                                        <DatePicker.Triggers>
                                            <DataTrigger Binding="{Binding HasStartDate}" TargetType="DatePicker" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource MutedForeground}" />
                                            </DataTrigger>
                                        </DatePicker.Triggers>
                                    </DatePicker>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding ClearStartDateCommand}"
                                        FontFamily="Segoe MDL2 Assets"
                                        IsVisible="{Binding HasStartDate}"
                                        Style="{StaticResource IconToggleButtonStyle}"
                                        Text="&#xE711;"
                                        WidthRequest="36" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FinishDateLabel}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <DatePicker Grid.Column="0" Date="{Binding FinishDate}">
                                        <DatePicker.Triggers>
                                            <DataTrigger Binding="{Binding HasFinishDate}" TargetType="DatePicker" Value="False">
                                                <Setter Property="TextColor" Value="{DynamicResource MutedForeground}" />
                                            </DataTrigger>
                                        </DatePicker.Triggers>
                                    </DatePicker>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding ClearFinishDateCommand}"
                                        FontFamily="Segoe MDL2 Assets"
                                        IsVisible="{Binding HasFinishDate}"
                                        Style="{StaticResource IconToggleButtonStyle}"
                                        Text="&#xE711;"
                                        WidthRequest="36" />
                                </Grid>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{DynamicResource Border}" />

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TagsLabel}" />
                                <FlexLayout
                                    BindableLayout.ItemsSource="{Binding TagChips}"
                                    Direction="Row"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Margin="0,0,8,8"
                                                Padding="12,6"
                                                BackgroundColor="{DynamicResource Muted}"
                                                Stroke="{DynamicResource Border}"
                                                StrokeShape="RoundRectangle 14"
                                                StrokeThickness="1">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label FontSize="13" Text="{Binding .}" VerticalTextAlignment="Center" />
                                                    <Label
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="10"
                                                        Text="&#xE711;"
                                                        TextColor="{DynamicResource MutedForeground}"
                                                        VerticalTextAlignment="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveTagCommand}" CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Entry
                                    Placeholder="{Binding TagsPlaceholder}"
                                    ReturnCommand="{Binding AddTagCommand}"
                                    ReturnType="Done"
                                    Text="{Binding NewTagText}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding DescriptionLabel}" />
                                <Editor AutoSize="TextChanges" HeightRequest="72" Placeholder="{Binding DescriptionPlaceholder}" Text="{Binding Description}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding NotesLabel}" />
                                <Editor AutoSize="TextChanges" HeightRequest="72" Placeholder="{Binding NotesPlaceholder}" Text="{Binding Notes}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding ShowBookFields}" Spacing="18">
                        <BoxView HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label FontAttributes="Bold" FontSize="18" Text="{Binding BookDetailsSectionTitle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
                            <VerticalStackLayout Grid.Column="0" Spacing="16">
                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding AuthorsLabel}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Authors}" Direction="Row" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:ContributorChipViewModel">
                                            <Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14">
                                                <HorizontalStackLayout Spacing="7">
                                                    <Label Text="{Binding Name}" VerticalTextAlignment="Center" />
                                                    <Label Text="↑" TextColor="{DynamicResource MutedForeground}"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MoveContributorUpCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label>
                                                    <Label Text="↓" TextColor="{DynamicResource MutedForeground}"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MoveContributorDownCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label>
                                                    <Label Text="&#x2715;" TextColor="{DynamicResource MutedForeground}"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveContributorCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Author" HorizontalOptions="Start" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" />

                                <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TranslatorsLabel}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Translators}" Direction="Row" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Label Text="&#x2715;"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveContributorCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Translator" HorizontalOptions="Start" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding IllustratorsLabel}" /><Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Illustrator" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" /></VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditorsLabel}" /><Button Command="{Binding OpenPersonPickerCommand}" CommandParameter="Editor" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding AddPersonText}" /></VerticalStackLayout>
                                </Grid>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Illustrators}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Label Text="&#x2715;"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveContributorCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Editors}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:ContributorChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Name}" /><Label Text="&#x2715;"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveContributorCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding GenresLabel}" />
                                    <FlexLayout BindableLayout.ItemsSource="{Binding GenreChips}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="x:String"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding .}" /><Label Text="&#x2715;"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveGenreCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                                    <Entry Placeholder="{Binding GenresPlaceholder}" ReturnCommand="{Binding AddGenreCommand}" ReturnType="Done" Text="{Binding NewGenreText}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding SubtitleLabel}" /><Entry Text="{Binding Subtitle}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionLabel}" /><Entry Text="{Binding Edition}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionNumberLabel}" /><Entry Keyboard="Numeric" Text="{Binding EditionNumber}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BookFormatLabel}" /><Picker ItemDisplayBinding="{Binding DisplayName}" ItemsSource="{Binding BookFormats}" SelectedItem="{Binding SelectedBookFormat}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalPublicationYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding OriginalPublicationYear}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding EditionYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding EditionYear}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding TranslationYearLabel}" /><Entry Keyboard="Numeric" Text="{Binding TranslationYear}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding OriginalLanguageLabel}" /><Entry Text="{Binding OriginalLanguage}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BookLanguageLabel}" /><Entry Text="{Binding BookLanguage}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding PageCountLabel}" /><Entry Keyboard="Numeric" Text="{Binding PageCount}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding Isbn10Label}" /><Entry Text="{Binding Isbn10}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding Isbn13Label}" /><Entry Text="{Binding Isbn13}" /></VerticalStackLayout></Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding BindingLabel}" /><Entry Text="{Binding Binding}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CountryOfOriginLabel}" /><Entry Text="{Binding CountryOfOrigin}" /></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="6"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding AgeRatingLabel}" /><Entry Text="{Binding AgeRating}" /></VerticalStackLayout></Grid>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
                            <VerticalStackLayout Spacing="10">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding CollectionsSectionTitle}" />
                                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10"><Entry Placeholder="{Binding CollectionNamePlaceholder}" Text="{Binding CollectionName}" /><Picker Grid.Column="1" ItemDisplayBinding="{Binding DisplayName}" ItemsSource="{Binding CollectionKinds}" SelectedItem="{Binding SelectedCollectionKind}" /><Entry Grid.Column="2" Keyboard="Numeric" Placeholder="{Binding EditionNumberLabel}" Text="{Binding CollectionPosition}" /></Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="10">
                                <Label FontAttributes="Bold" FontSize="16" Text="{Binding RelationsSectionTitle}" />
                                <Grid ColumnDefinitions="*,150" ColumnSpacing="10"><Entry Placeholder="{Binding RelatedSearchPlaceholder}" Text="{Binding RelatedSearchText}" /><Picker Grid.Column="1" ItemDisplayBinding="{Binding DisplayName}" ItemsSource="{Binding RelationKinds}" SelectedItem="{Binding SelectedRelationKind}" /></Grid>
                                <CollectionView HeightRequest="100" ItemsSource="{Binding RelatedSearchResults}"><CollectionView.ItemTemplate><DataTemplate x:DataType="{x:Null}"><Button Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddRelatedItemCommand}" CommandParameter="{Binding .}" HorizontalOptions="Fill" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding Title}" /></DataTemplate></CollectionView.ItemTemplate></CollectionView>
                                <FlexLayout BindableLayout.ItemsSource="{Binding RelatedItems}" Direction="Row" Wrap="Wrap"><BindableLayout.ItemTemplate><DataTemplate x:DataType="viewModels:RelatedItemChipViewModel"><Border Margin="0,0,8,8" Padding="10,5" BackgroundColor="{DynamicResource Muted}" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 14"><HorizontalStackLayout Spacing="7"><Label Text="{Binding Title}" /><Label Text="&#x2715;"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveRelatedItemCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label></HorizontalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,180" ColumnSpacing="14">
                        <Button Grid.Column="0" Command="{Binding CancelCommand}" HeightRequest="46" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding CancelButtonText}" />
                        <Button Grid.Column="1" Command="{Binding SaveCommand}" HeightRequest="46" Text="{Binding SaveButtonText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <Grid Grid.ColumnSpan="3" BackgroundColor="#99000000" IsVisible="{Binding IsPersonPickerOpen}" Padding="24">
            <Border Padding="24" BackgroundColor="{DynamicResource Card}" HorizontalOptions="Center" Stroke="{DynamicResource Border}" StrokeShape="RoundRectangle 16" VerticalOptions="Center" WidthRequest="500">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><Label FontAttributes="Bold" FontSize="20" Text="{Binding PersonPickerTitle}" /><Button Grid.Column="1" Command="{Binding ClosePersonPickerCommand}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconToggleButtonStyle}" Text="&#xE711;" /></Grid>
                    <Entry Placeholder="{Binding SearchPersonPlaceholder}" Text="{Binding PersonSearchText}" />
                    <CollectionView HeightRequest="260" ItemsSource="{Binding PersonSearchResults}">
                        <CollectionView.ItemTemplate><DataTemplate x:DataType="{x:Null}"><Button Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectPersonCommand}" CommandParameter="{Binding .}" HorizontalOptions="Fill" Style="{StaticResource SecondaryButtonStyle}" Text="{Binding Name}" /></DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Command="{Binding CreatePersonCommand}" Text="{Binding CreatePersonText}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
