<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PersonalCollectionShelf.App.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:PersonalCollectionShelf.App.ViewModels"
    x:DataType="viewModels:LibraryViewModel"
    BackgroundColor="{DynamicResource PageBackground}"
    Shell.NavBarIsVisible="False"
    Title="{Binding StatisticsTitle}">
    <Grid BackgroundColor="{DynamicResource PageBackground}" RowDefinitions="54,Auto,*">
        <Grid x:Name="TopBar" Padding="14,7">
            <Label FontAttributes="Bold" FontFamily="Cambria" FontSize="24" Text="{Binding StatisticsTitle}" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="12,6,12,8" Padding="4" BackgroundColor="{DynamicResource Muted}" ColumnDefinitions="*,*" RowDefinitions="42,42" ColumnSpacing="4" RowSpacing="4">
            <Button x:Name="OverviewTabButton" Clicked="HandleStatisticsTabClicked" CommandParameter="overview" CornerRadius="10" Padding="8,0" Text="{Binding StatisticsOverviewTab}" />
            <Button x:Name="TimeTabButton" Grid.Column="1" Clicked="HandleStatisticsTabClicked" CommandParameter="time" CornerRadius="10" Padding="8,0" Text="{Binding StatisticsTimeTab}" />
            <Button x:Name="GenresTabButton" Grid.Row="1" Clicked="HandleStatisticsTabClicked" CommandParameter="genres" CornerRadius="10" Padding="8,0" Text="{Binding StatisticsGenresTab}" />
            <Button x:Name="RatingsTabButton" Grid.Row="1" Grid.Column="1" Clicked="HandleStatisticsTabClicked" CommandParameter="ratings" CornerRadius="10" Padding="8,0" Text="{Binding StatisticsRatingsTab}" />
        </Grid>

        <ScrollView Grid.Row="2" BackgroundColor="{DynamicResource PageBackground}">
            <VerticalStackLayout x:Name="StatisticsContent" Padding="12,8,12,32" HorizontalOptions="Fill" MaximumWidthRequest="920" Spacing="14">
                <VerticalStackLayout x:Name="OverviewSection" Spacing="14">
                    <Grid x:Name="SummaryGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border x:Name="CollectionCard" Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="3"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CollectionLabel}" /><Label FontAttributes="Bold" FontSize="28" Text="{Binding TotalItemCount}" /></VerticalStackLayout></Border>
                        <Border x:Name="CompletionCard" Grid.Column="1" Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="3"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding CompletionLabel}" /><Label FontAttributes="Bold" FontSize="28" Text="{Binding CompletionPercentText}" TextColor="{DynamicResource Primary}" /></VerticalStackLayout></Border>
                        <Border x:Name="RatingCard" Grid.Row="1" Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="3"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding AverageRatingLabel}" /><Label FontAttributes="Bold" FontSize="28" Text="{Binding AverageRatingText}" TextColor="{StaticResource Warning}" /></VerticalStackLayout></Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="3"><Label Style="{StaticResource TinyCapsLabelStyle}" Text="{Binding FavoritesItemsLabel}" /><Label FontAttributes="Bold" FontSize="28" Text="{Binding FavoritesItemCount}" TextColor="#F07CB8" /></VerticalStackLayout></Border>
                    </Grid>

                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ByCategoryTitle}" /><GraphicsView x:Name="DonutChart" HeightRequest="220" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ByStatusTitle}" /><GraphicsView x:Name="BarChart" HeightRequest="220" /></VerticalStackLayout></Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TimeSection" IsVisible="False" Spacing="14">
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding MonthlyActivityTitle}" /><GraphicsView x:Name="MonthlyChart" HeightRequest="210" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ReleasesByYearTitle}" /><GraphicsView x:Name="ReleaseYearChart" HeightRequest="250" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding AddedByYearTitle}" /><GraphicsView x:Name="AddedYearChart" HeightRequest="220" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ByDecadeTitle}" /><GraphicsView x:Name="DecadeChart" HeightRequest="240" /></VerticalStackLayout></Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GenresSection" IsVisible="False" Spacing="14">
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ByGenreTitle}" /><GraphicsView x:Name="GenreChart" HeightRequest="440" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding ByCountryTitle}" /><GraphicsView x:Name="CountryChart" HeightRequest="370" /></VerticalStackLayout></Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="RatingsSection" IsVisible="False" Spacing="14">
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding RatingDistributionTitle}" /><GraphicsView x:Name="RatingChart" HeightRequest="230" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding AverageRatingByTypeTitle}" /><GraphicsView x:Name="AverageByTypeChart" HeightRequest="300" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding CompletionByTypeTitle}" /><GraphicsView x:Name="CompletionByTypeChart" HeightRequest="300" /></VerticalStackLayout></Border>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}"><VerticalStackLayout Spacing="10"><Label Style="{StaticResource SectionTitleLabelStyle}" Text="{Binding FavoritesByTypeTitle}" /><GraphicsView x:Name="FavoritesByTypeChart" HeightRequest="300" /></VerticalStackLayout></Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
